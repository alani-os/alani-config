{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alani Config Profile",
  "description": "Machine-readable schema metadata for alani.config.v1 TOML-like profiles.",
  "x-alani-schema-version": "alani.config.v1",
  "x-alani-profile-modes": ["host", "emulator", "hardware"],
  "x-alani-fields": [
    {"domain": "environment", "key": "name", "kind": "string", "required": true, "data_class": "public"},
    {"domain": "environment", "key": "mode", "kind": "enum", "required": true, "data_class": "public", "allowed": ["host", "emulator", "hardware"]},
    {"domain": "environment", "key": "target", "kind": "string", "required": true, "data_class": "operational"},
    {"domain": "environment", "key": "log_level", "kind": "enum", "required": false, "data_class": "operational", "allowed": ["error", "warn", "info", "debug", "trace"]},
    {"domain": "environment", "key": "host_mocks", "kind": "boolean", "required": false, "data_class": "operational"},
    {"domain": "boot", "key": "kernel_path", "kind": "string", "required": true, "data_class": "operational"},
    {"domain": "boot", "key": "init_profile", "kind": "string", "required": true, "data_class": "operational"},
    {"domain": "boot", "key": "command_line", "kind": "string", "required": false, "data_class": "sensitive"},
    {"domain": "boot", "key": "memory_limit_bytes", "kind": "integer", "required": false, "data_class": "operational", "min": 1048576, "max": 1099511627776},
    {"domain": "boot", "key": "require_measurements", "kind": "boolean", "required": false, "data_class": "operational"},
    {"domain": "runtime", "key": "max_processes", "kind": "integer", "required": true, "data_class": "operational", "min": 1, "max": 4096},
    {"domain": "runtime", "key": "max_agents", "kind": "integer", "required": true, "data_class": "operational", "min": 0, "max": 1024},
    {"domain": "runtime", "key": "default_priority", "kind": "integer", "required": false, "data_class": "operational", "min": 0, "max": 255},
    {"domain": "runtime", "key": "enable_mock_cognition", "kind": "boolean", "required": false, "data_class": "operational"},
    {"domain": "runtime", "key": "supervision_tick_ms", "kind": "integer", "required": false, "data_class": "operational", "min": 1, "max": 60000},
    {"domain": "security", "key": "secure_boot", "kind": "boolean", "required": true, "data_class": "operational"},
    {"domain": "security", "key": "audit_required", "kind": "boolean", "required": true, "data_class": "operational"},
    {"domain": "security", "key": "policy_bundle", "kind": "string", "required": true, "data_class": "sensitive"},
    {"domain": "security", "key": "allow_unsigned", "kind": "boolean", "required": false, "data_class": "sensitive"},
    {"domain": "security", "key": "min_key_bits", "kind": "integer", "required": false, "data_class": "operational", "min": 128, "max": 8192},
    {"domain": "devices", "key": "console", "kind": "enum", "required": true, "data_class": "operational", "allowed": ["mock", "virtio", "native", "disabled"]},
    {"domain": "devices", "key": "storage", "kind": "enum", "required": false, "data_class": "operational", "allowed": ["memory", "disk", "disabled"]},
    {"domain": "devices", "key": "network", "kind": "enum", "required": false, "data_class": "operational", "allowed": ["mock", "virtio", "native", "disabled"]},
    {"domain": "devices", "key": "cognition", "kind": "enum", "required": false, "data_class": "operational", "allowed": ["mock", "virtio", "native", "disabled"]},
    {"domain": "devices", "key": "max_device_buffers", "kind": "integer", "required": false, "data_class": "operational", "min": 1, "max": 4096},
    {"domain": "corpus", "key": "root_path", "kind": "string", "required": false, "data_class": "sensitive"},
    {"domain": "corpus", "key": "label_schema", "kind": "string", "required": false, "data_class": "operational"},
    {"domain": "corpus", "key": "max_records", "kind": "integer", "required": false, "data_class": "operational", "min": 1, "max": 10000000},
    {"domain": "corpus", "key": "allow_synthetic", "kind": "boolean", "required": false, "data_class": "operational"},
    {"domain": "release", "key": "channel", "kind": "enum", "required": false, "data_class": "public", "allowed": ["dev", "nightly", "stable"]},
    {"domain": "release", "key": "build_id", "kind": "string", "required": false, "data_class": "public"},
    {"domain": "release", "key": "sbom_path", "kind": "string", "required": false, "data_class": "operational"},
    {"domain": "release", "key": "evidence_required", "kind": "boolean", "required": false, "data_class": "operational"},
    {"domain": "release", "key": "signing_required", "kind": "boolean", "required": false, "data_class": "sensitive"}
  ]
}
